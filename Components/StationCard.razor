@using DublinBikesWeb.Models

<div class="card h-100 shadow-sm">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Station.name</h5>
        <p class="card-text text-muted mb-1">@Station.address</p>
        <p class="card-text mb-3"><strong>Status:</strong> @Station.status</p>

        <button class="btn btn-primary mt-auto" @onclick="SelectStation"> @**This button allows the user to view more details about the station.*@
            View Details
        </button>
    </div>
</div>

@code {
    [Parameter]
    public DublinBikesData Station { get; set; } = default!; @** This parameter represents the station data to display in the card*@

    [Parameter]
    public EventCallback<DublinBikesData> OnSelect { get; set; } @**This parameter represents the event callback for when a station is selected*@

    private async Task SelectStation() => await OnSelect.InvokeAsync(Station); @**This method is called when the user clicks the "View Details" button*@
}
